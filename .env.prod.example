# Copy to .env.prod on the server (git-ignored). Use new secrets, never the development ones.
DB_NAME=sapulmrf
DB_USER=sapulmrf
# Letters and digits only: this goes into a database URL, where / and % break it.
DB_PASSWORD=

# A domain gets a public certificate. localhost or an IP gets one from Caddy's own authority.
SITE_ADDRESS=localhost
HTTP_PORT=80
HTTPS_PORT=443

# Point this at an external drive, so a dead server disk doesn't take the backups with it.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
