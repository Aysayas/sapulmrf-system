# A real domain gets a free public certificate; localhost or an IP gets one from Caddy's own authority.
{$SITE_ADDRESS:localhost} {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
	}

	handle_path /api/* {
		reverse_proxy api:8000
	}

	# A missing file must be a 404, not index.html: the page then offers a reload after a deploy.
	handle /assets/* {
		root * /srv
		@found file
		header @found Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
